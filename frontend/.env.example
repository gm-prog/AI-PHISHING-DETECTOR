# SENTINEL AI — frontend environment template
#
# Copy to `.env.local` (git-ignored) for local overrides, or set these in the
# hosting provider's build environment for deployed builds.
#
# Everything in this file is PUBLIC. Vite inlines VITE_* variables into the
# JavaScript bundle that every visitor downloads. Never put an API key, token,
# password, or any other secret in a VITE_* variable.

# Public origin of the SENTINEL backend, used for every API call
# (/api/health, /api/auth/*, /api/analyze, /api/history).
#
#   - BUILD-TIME: changing it requires a rebuild and redeploy of the frontend.
#   - Format: scheme + host only. No path, query, fragment, or trailing slash.
#     The client appends the `/api/...` prefix itself.
#   - Must be https and non-loopback for a deployment build.
#   - REQUIRED for a deployable build. If unset, the app falls back to
#     http://127.0.0.1:8000, which only works on a developer machine.
#
# Validated at build time by scripts/validate-api-base-url.mjs: placeholders,
# malformed origins and non-origin URL components fail every build; missing,
# loopback, or non-https values warn locally and fail deployment builds.
VITE_API_BASE_URL=http://127.0.0.1:8000
