# Reference environment template for the AI Phishing Detector backend
# Copy this file to '.env' and fill in your Gemini API key.

# Google Gemini API Key for semantic and social-engineering phishing checks
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...your_gemini_key_here

# Optional Google Web Risk API key for server-side URL threat intelligence
GOOGLE_WEB_RISK_API_KEY=

# Optional VirusTotal API key for URL reputation scanning
VIRUSTOTAL_API_KEY=

# Server running configurations
HOST=127.0.0.1
PORT=8000
